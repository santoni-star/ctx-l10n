{
  "name": "ctx-l10n",
  "version": "0.1.0",
  "description": "Context-aware, self-validating localization engine powered by project documentation, OpenAI-compatible LLMs, CLI, MCP, and GitHub Actions.",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "ctx-l10n": "dist/src/entrypoints/cli.js",
    "ctx-l10n-mcp": "dist/src/entrypoints/mcp.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "cli": "node dist/src/entrypoints/cli.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "fast-xml-parser": "^5.2.3",
    "yaml": "^2.7.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
